# ==============================================================================
# GIL Enterprise Accounting Platform — Environment Configuration Template
# Placeholders only. Do NOT commit production credentials or actual secrets.
# ==============================================================================

# Execution Environment ('development' | 'staging' | 'production')
NODE_ENV=development

# PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/gil

# Redis Connection URL (Session Store, Cache, Rate Limiting)
# Format: redis://:[password]@[host]:[port]/[db_index]
REDIS_URL=redis://localhost:6379/0

# JWT Signing Secret (Minimum 32 random characters for HMAC-SHA256)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# Application Base URLs
NUXT_PUBLIC_APP_NAME="GIL Enterprise Accounting Platform"
NUXT_PUBLIC_APP_VERSION="1.0.0"
